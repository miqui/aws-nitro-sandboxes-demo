#!/usr/bin/env python3
"""run-sandbox <file.py> [options] : run untrusted code in a Nitro Sandbox. See app/README.md."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from sandbox_launcher.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
